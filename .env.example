# Copie para .env e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). A chave "anon" é pública por natureza: a
# segurança fica nas regras de RLS da migração em supabase/migrations/.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Endereço final do site (usado nos links de compartilhamento).
SITE_URL=http://localhost:4321
