---
/**
 * Iniciais no lugar da foto da conta Google: não carregamos imagens de
 * terceiros, para não entregar a visita de ninguém a outro servidor.
 */
import { iniciais } from '../../lib/caderno';

interface Props {
  nome: string;
  tamanho?: number;
}

const { nome, tamanho = 40 } = Astro.props;
---

<span class="monograma" aria-hidden="true" style={`--tamanho:${tamanho}px`}>{iniciais(nome)}</span>

<style>
  .monograma {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--tamanho);
    height: var(--tamanho);
    border: 1px solid var(--cor-destaque);
    border-radius: 50%;
    color: var(--cor-destaque);
    font-family: var(--fonte-titulo);
    font-size: calc(var(--tamanho) * 0.38);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
  }
</style>
