---
import Ratinho from './Ratinho.astro';

const caminho = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', rotulo: 'Início', ativo: caminho === '/' || caminho.startsWith('/caderno'), classe: 'link-inicio' },
  { href: '/cardapio', rotulo: 'Cardápio', ativo: caminho === '/cardapio' || caminho.startsWith('/receitas') },
  { href: '/sobre', rotulo: 'Sobre', ativo: caminho === '/sobre' },
];
---

<header class="cabecalho" data-cabecalho>
  <div class="dentro">
    <a class="marca" href="/">
      <Ratinho tamanho={52} class="ratinho-marca" />
      <span class="versalete rotulo nome-marca">La cucina brasiliana</span>
      <span class="apenas-leitor">, página inicial</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          links.map((link) => (
            <li class={link.classe}>
              <a
                class="versalete"
                href={link.href}
                aria-current={link.ativo ? (link.href === caminho ? 'page' : 'true') : undefined}
              >
                {link.rotulo}
              </a>
            </li>
          ))
        }
        <li data-item-conta hidden>
          <a
            class="conta"
            href="/conta"
            aria-label="Minha conta"
            aria-current={caminho === '/conta' ? 'page' : undefined}
            data-link-conta
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <circle cx="12" cy="8.5" r="3.75" />
              <path d="M4.75 20c.9-3.6 3.75-5.6 7.25-5.6s6.35 2 7.25 5.6" />
            </svg>
            <span class="novas" data-novas hidden></span>
          </a>
        </li>
        <li>
          <button class="tema" type="button" aria-label="Tema escuro" aria-pressed="false">
            <svg class="icone-lua" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />
            </svg>
            <svg class="icone-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path
                d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
              />
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Fixo no topo; ao rolar a página, encolhe (data-compacto) */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--cor-fundo);
    border-bottom: 1px solid var(--cor-borda);
    transition: box-shadow 0.2s ease;
  }

  .cabecalho[data-compacto] {
    box-shadow: 0 6px 18px -14px var(--cor-destaque);
  }

  .dentro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    width: 100%;
    max-width: var(--largura-pagina);
    margin-inline: auto;
    padding: 1.1rem 1rem 0.9rem;
    transition: padding 0.2s ease;
  }

  [data-compacto] .dentro {
    padding-block: 0.45rem 0.4rem;
  }

  @media (min-width: 40rem) {
    .dentro {
      padding-inline: var(--respiro);
    }
  }

  .marca {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  /* O Ratinho recebe a largura inline; aqui ela muda com o modo compacto */
  .marca :global(.ratinho-marca) {
    width: 52px !important;
    transition: width 0.2s ease;
  }

  [data-compacto] .marca :global(.ratinho-marca) {
    width: 38px !important;
  }

  .nome-marca {
    letter-spacing: 0.32em;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li[hidden] {
    display: none;
  }

  nav a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--cor-destaque);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a[aria-current] {
    border-bottom-color: currentColor;
  }

  /* Telas médias: o nome da casa sai do cabeçalho antes de a navegação quebrar linha */
  @media (max-width: 47.99rem) {
    .nome-marca {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    ul {
      gap: 1.25rem;
    }
  }

  /* Celular: o ratinho já leva ao início, então o link "Início" sai, e tudo aperta */
  @media (max-width: 25rem) {
    .link-inicio {
      display: none;
    }

    ul {
      gap: 0.9rem;
    }

    nav .versalete {
      letter-spacing: 0.24em;
    }
  }

  /* Conta: ícone com o número de opiniões novas */
  .conta {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border-bottom: 0;
    border-radius: 50%;
  }

  .conta[aria-current] {
    box-shadow: inset 0 0 0 1px var(--cor-destaque);
  }

  .conta svg,
  .tema svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .novas {
    position: absolute;
    top: 0.1rem;
    right: -0.15rem;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.3rem;
    border-radius: 0.6rem;
    background: var(--cor-rotulo);
    color: var(--cor-fundo);
    font-family: var(--fonte-texto);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2rem;
    text-align: center;
  }

  .novas[hidden] {
    display: none;
  }

  /* Alternador de tema: mostra a lua no claro e o sol no escuro */
  .tema {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-inline-end: -0.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--cor-destaque);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .tema:hover {
    color: var(--cor-destaque-hover);
  }

  .icone-sol,
  :global(:root[data-tema='escuro']) .icone-lua {
    display: none;
  }

  :global(:root[data-tema='escuro']) .icone-sol {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-tema='claro'])) .icone-lua {
      display: none;
    }

    :global(:root:not([data-tema='claro'])) .icone-sol {
      display: block;
    }
  }
</style>

<script>
  import { buscarSessao, sessaoConhecida, type Sessao } from '../lib/navegador/sessao';

  /* ---------- Tema ---------- */

  const botao = document.querySelector<HTMLButtonElement>('.tema');
  const raiz = document.documentElement;
  const sistemaEscuro = window.matchMedia('(prefers-color-scheme: dark)');

  const temaAtual = () => raiz.dataset.tema ?? (sistemaEscuro.matches ? 'escuro' : 'claro');

  const atualizarBotao = () => {
    botao?.setAttribute('aria-pressed', String(temaAtual() === 'escuro'));
  };

  botao?.addEventListener('click', () => {
    const tema = temaAtual() === 'escuro' ? 'claro' : 'escuro';
    raiz.dataset.tema = tema;
    const cor = tema === 'escuro' ? '#1F2D4D' : '#F6F0E4';
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute('content', cor));
    try {
      localStorage.setItem('tema', tema);
    } catch {}
    atualizarBotao();
  });

  sistemaEscuro.addEventListener('change', atualizarBotao);
  atualizarBotao();

  /* ---------- Compacto ao rolar ---------- */

  const cabecalho = document.querySelector<HTMLElement>('[data-cabecalho]');
  let compacto = false;
  let agendado = false;

  // Dois limites diferentes para não ficar piscando bem na divisa.
  const medir = () => {
    agendado = false;
    const y = window.scrollY;
    const deveria = compacto ? y > 8 : y > 56;
    if (deveria !== compacto && cabecalho) {
      compacto = deveria;
      cabecalho.toggleAttribute('data-compacto', compacto);
    }
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!agendado) {
        agendado = true;
        requestAnimationFrame(medir);
      }
    },
    { passive: true },
  );
  medir();

  /* ---------- Conta e opiniões novas ---------- */

  const item = document.querySelector<HTMLElement>('[data-item-conta]');
  const link = document.querySelector<HTMLAnchorElement>('[data-link-conta]');
  const selo = document.querySelector<HTMLElement>('[data-novas]');

  const mostrarConta = (sessao: Sessao) => {
    if (!item || !link || !selo) return;
    item.hidden = !sessao.conectado;
    const novas = sessao.novas ?? 0;
    selo.hidden = novas === 0;
    selo.textContent = novas > 9 ? '9+' : String(novas);
    link.href = novas > 0 ? '/conta#opinioes-recebidas' : '/conta';
    link.setAttribute(
      'aria-label',
      novas === 0 ? 'Minha conta' : `Minha conta, ${novas === 1 ? '1 opinião nova' : `${novas} opiniões novas`}`,
    );
  };

  mostrarConta(sessaoConhecida());
  // Na própria conta as novidades acabaram de ser vistas: pergunta de novo, sem atalho.
  buscarSessao({ forcar: location.pathname.startsWith('/conta') }).then(mostrarConta);
</script>
