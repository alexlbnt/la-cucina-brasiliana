---
import Ratinho from './Ratinho.astro';

const caminho = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', rotulo: 'Início', ativo: caminho === '/' || caminho.startsWith('/caderno') },
  { href: '/cardapio', rotulo: 'Cardápio', ativo: caminho === '/cardapio' || caminho.startsWith('/receitas') },
  { href: '/sobre', rotulo: 'Sobre', ativo: caminho === '/sobre' },
];
---

<header class="cabecalho">
  <a class="marca" href="/">
    <Ratinho tamanho={52} />
    <span class="versalete rotulo">La cucina brasiliana</span>
    <span class="apenas-leitor">, página inicial</span>
  </a>
  <nav aria-label="Principal">
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              class="versalete"
              href={link.href}
              aria-current={link.ativo ? (link.href === caminho ? 'page' : 'true') : undefined}
            >
              {link.rotulo}
            </a>
          </li>
        ))
      }
      <li>
        <button class="tema" type="button" aria-label="Tema escuro" aria-pressed="false">
          <svg class="icone-lua" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />
          </svg>
          <svg class="icone-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    width: 100%;
    max-width: var(--largura-pagina);
    margin-inline: auto;
    padding: 1.25rem 1rem 1rem;
    border-bottom: 1px solid var(--cor-borda);
  }

  @media (min-width: 40rem) {
    .cabecalho {
      padding-inline: var(--respiro);
    }
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .marca .versalete {
    letter-spacing: 0.32em;
  }

  ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--cor-destaque);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a[aria-current] {
    border-bottom-color: currentColor;
  }

  ul {
    align-items: center;
  }

  /* Alternador de tema: mostra a lua no claro e o sol no escuro */
  .tema {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-inline-end: -0.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--cor-destaque);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .tema:hover {
    color: var(--cor-destaque-hover);
  }

  .tema svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icone-sol,
  :global(:root[data-tema='escuro']) .icone-lua {
    display: none;
  }

  :global(:root[data-tema='escuro']) .icone-sol {
    display: block;
  }
</style>

<script>
  const botao = document.querySelector<HTMLButtonElement>('.tema');
  const raiz = document.documentElement;

  const atualizarBotao = () => {
    botao?.setAttribute('aria-pressed', String(raiz.dataset.tema === 'escuro'));
  };

  botao?.addEventListener('click', () => {
    const tema = raiz.dataset.tema === 'escuro' ? 'claro' : 'escuro';
    raiz.dataset.tema = tema;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', tema === 'escuro' ? '#1F2D4D' : '#F6F0E4');
    try {
      localStorage.setItem('tema', tema);
    } catch {}
    atualizarBotao();
  });

  atualizarBotao();
</script>
