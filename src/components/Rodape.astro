---
import Ratinho from './Ratinho.astro';
---

<footer class="rodape">
  <Ratinho tamanho={84} />
  <p class="versalete">Buon appetito</p>
  <p class="links"><a href="/privacidade">Privacidade</a> · <a href="/termos">Termos de uso</a></p>
</footer>

<style>
  .rodape {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 3rem 1rem 3.5rem;
  }

  p {
    color: var(--cor-texto-3);
  }

  .links {
    font-size: 0.95rem;
  }

  .links a {
    color: inherit;
  }

  .links a:hover {
    color: var(--cor-destaque);
  }
</style>
