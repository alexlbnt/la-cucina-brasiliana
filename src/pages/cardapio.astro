---
import Base from '../layouts/Base.astro';
import Moldura from '../components/Moldura.astro';
import Separador from '../components/Separador.astro';
import Esgabilado from '../components/Esgabilado.astro';
import type { Categoria } from '../lib/categorias';
import { agruparPorCategoria, formatarNumero, listarReceitas, urlDaReceita } from '../lib/receitas';

const secoes = agruparPorCategoria(await listarReceitas());

/** Seções que ganham uma cena do Esgabilado ao lado do título. */
const cenasDaSecao: Partial<Record<Categoria, 'queijo'>> = { Acompanhamentos: 'queijo' };
---

<Base titulo="Cardápio" descricao="O cardápio de La cucina brasiliana: massas, arroz, peixes, acompanhamentos e ovos, do jeito que eu faço.">
  <div class="pagina">
    <Moldura>
      <header class="topo">
        <Esgabilado cena="prato" tamanho="min(42vw, 170px)" />
        <p class="versalete rotulo">La cucina brasiliana</p>
        <h1>Cardápio</h1>
        <Separador />
        <p class="frase">Base italiana, ingredientes simples e espaço para improvisar</p>
      </header>

      {
        secoes.map(({ categoria, receitas }) => {
          const idSecao = `secao-${categoria.toLowerCase()}`;
          const cena = cenasDaSecao[categoria];
          return (
            <section class="secao" aria-labelledby={idSecao}>
              <div class="cabeca-secao">
                <h2 id={idSecao} class="versalete">
                  {categoria}
                </h2>
                {cena && <Esgabilado cena={cena} tamanho="clamp(5rem, 14vw, 7.5rem)" class="cena-secao" />}
              </div>
              <ul class="pratos">
                {receitas.map((receita) => (
                  <li class="prato">
                    <h3>
                      <a href={urlDaReceita(receita)}>{receita.data.titulo}</a>
                    </h3>
                    <span class="numero" aria-hidden="true">
                      {formatarNumero(receita.data.numero)}
                    </span>
                    <p>{receita.data.descricao}</p>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }

      <div class="fim">
        <Separador />
      </div>
    </Moldura>
  </div>
</Base>

<style>
  .pagina {
    max-width: 56rem;
  }

  .topo {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
    margin-bottom: clamp(2rem, 6vw, 3.5rem);
  }

  h1 {
    font-size: clamp(3rem, 2rem + 6vw, 5.5rem);
    line-height: 1;
  }

  .frase {
    font-style: italic;
    color: var(--cor-texto-2);
  }

  .secao + .secao {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .cabeca-secao {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    color: var(--cor-destaque);
  }

  .cabeca-secao :global(.cena-secao) {
    flex-shrink: 0;
  }

  .pratos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prato {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1.25rem;
    row-gap: 0.4rem;
  }

  .prato + .prato {
    margin-top: 1.5rem;
  }

  h3 {
    text-wrap: pretty;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    color: var(--cor-texto);
  }

  h3 a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  h3 a:hover,
  h3 a:focus-visible {
    color: var(--cor-destaque);
    text-decoration-color: currentColor;
  }

  .numero {
    align-self: baseline;
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--cor-destaque);
  }

  .prato p {
    grid-column: 1 / -1;
    max-width: var(--largura-texto);
    color: var(--cor-texto-2);
  }

  .fim {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }
</style>
