---
import Base from '../layouts/Base.astro';
import Selo from '../components/Selo.astro';
import Separador from '../components/Separador.astro';
---

<Base>
  <section class="inicio pagina" aria-labelledby="titulo-inicio">
    <Selo tamanho="min(78vw, 380px)" class="selo-inicio" />
    <h1 id="titulo-inicio">La cucina brasiliana</h1>
    <Separador />
    <p class="frase">Base italiana, ingredientes simples e espaço para improvisar</p>
    <a class="botao" href="/cardapio">Ver o cardápio</a>
  </section>
</Base>

<style>
  .inicio {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
    padding-block: clamp(2rem, 7vw, 4.5rem) clamp(1rem, 4vw, 2rem);
  }

  .inicio :global(.selo-inicio) {
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 1.6rem + 4.5vw, 4.5rem);
    letter-spacing: -0.01em;
  }

  .frase {
    max-width: 26ch;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-style: italic;
    color: var(--cor-texto-2);
  }

  .botao {
    margin-top: 0.75rem;
  }
</style>
