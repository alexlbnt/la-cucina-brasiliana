---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Moldura from '../../components/Moldura.astro';
import Separador from '../../components/Separador.astro';
import FotoReservada from '../../components/FotoReservada.astro';
import Esgabilado from '../../components/Esgabilado.astro';
import { formatarNumero, listarReceitas, urlDaReceita, type Receita } from '../../lib/receitas';
import { assinaturaDaReceita } from '../../lib/cozinha';

export const getStaticPaths = (async () => {
  const receitas = await listarReceitas();
  return receitas.map((receita, i) => ({
    params: { slug: receita.id },
    props: {
      receita,
      anterior: receitas[i - 1],
      proxima: receitas[i + 1],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  receita: Receita;
  anterior?: Receita;
  proxima?: Receita;
}

const { receita, anterior, proxima } = Astro.props;
const { numero, titulo, categoria, descricao, ingredientes, preparo, variacoes, foto } = receita.data;
const temVariacoes = variacoes && variacoes.length > 0;
const assinatura = assinaturaDaReceita(ingredientes, preparo);

// Dados estruturados (Schema.org Recipe): o Google mostra a receita com destaque.
const endereco = new URL(urlDaReceita(receita), Astro.site).href;
const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: titulo,
  description: descricao,
  url: endereco,
  inLanguage: 'pt-BR',
  image: [new URL(foto ?? '/og.png', Astro.site).href],
  author: { '@type': 'Person', name: 'Chef Alex' },
  publisher: { '@type': 'Organization', name: 'La cucina brasiliana', url: new URL('/', Astro.site).href },
  recipeCategory: categoria,
  recipeCuisine: 'Ítalo-brasileira',
  keywords: [categoria, 'receita caseira', 'cozinha italiana', 'La cucina brasiliana'].join(', '),
  recipeIngredient: ingredientes,
  recipeInstructions: preparo.map((texto, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text: texto,
    url: `${endereco}#passo-${i + 1}`,
  })),
};
// "<" escapado: nenhum texto de receita consegue fechar a tag <script>.
const jsonLd = JSON.stringify(dadosEstruturados).replace(/</g, '\\u003c');
---

<Base titulo={titulo} descricao={descricao}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />

  <div class="pagina">
    <div class="receita" data-receita={receita.id} data-assinatura={assinatura}>
    <Moldura as="article">
      <header class="topo">
        <p class="versalete categoria">Receita {formatarNumero(numero)} · {categoria}</p>
        <h1 id="titulo-receita" tabindex="-1">{titulo}</h1>
        <p class="descricao">{descricao}</p>
        <Separador />
      </header>

      <div class="foto">
        {foto ? <img src={foto} alt={titulo} loading="lazy" decoding="async" /> : <FotoReservada />}
      </div>

      <div class="corpo">
        <section class="ingredientes" aria-labelledby="titulo-ingredientes" data-ingredientes>
          <div class="cabeca">
            <h2 id="titulo-ingredientes" class="versalete rotulo">Ingredientes</h2>
            <span class="contagem" data-contagem-ingredientes hidden></span>
          </div>
          <button
            type="button"
            class="abrir-ingredientes"
            data-abrir-ingredientes
            aria-expanded="true"
            aria-controls="lista-ingredientes"
          >
            <span class="versalete">Ingredientes</span>
            <span class="contagem" data-contagem-ingredientes></span>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <ul class="lista-ingredientes" id="lista-ingredientes">
            {
              ingredientes.map((item, i) => (
                <li data-item-ingrediente={i}>
                  <label class="marcavel">
                    <input type="checkbox" class="caixa" data-ingrediente={i} disabled />
                    <span class="texto">{item}</span>
                  </label>
                </li>
              ))
            }
          </ul>
          <p class="no-olho">Quantidades no olho, como o coração mandar!</p>
        </section>

        <section class="preparo" aria-labelledby="titulo-preparo">
          <div class="cabeca">
            <h2 id="titulo-preparo" class="versalete rotulo">Preparo</h2>
            <span class="contagem" data-contagem-passos hidden></span>
          </div>
          <p class="passo-de versalete" data-passo-de></p>

          <ol class="passos" data-passos>
            {
              preparo.map((passo, i) => (
                <li id={`passo-${i + 1}`} data-passo={i}>
                  <label class="marcavel">
                    <input type="checkbox" class="apenas-leitor" data-marca-passo={i} disabled />
                    <span class="numero" aria-hidden="true">
                      <span class="algarismo">{i + 1}</span>
                      <svg class="visto" viewBox="0 0 24 24" width="28" height="28">
                        <path d="m5 12.5 4.5 4.5L19 7.5" />
                      </svg>
                    </span>
                    <span class="texto">
                      <span class="apenas-leitor">Passo {i + 1}: </span>
                      {passo}
                    </span>
                  </label>
                </li>
              ))
            }
          </ol>

          <div class="navegar" data-navegar>
            <button type="button" class="botao anterior" data-anterior aria-label="Passo anterior">
              <span aria-hidden="true">←</span><span class="rotulo-anterior" aria-hidden="true"> Anterior</span>
            </button>
            <button type="button" class="botao cheio" data-feito></button>
          </div>

          <div class="pronto" data-pronto hidden tabindex="-1">
            <Esgabilado cena="prato" tamanho="min(36vw, 140px)" />
            <p class="pronto-titulo">Pronto. Buon appetito!</p>
            <p class="pronto-texto">
              Como ficou? <a href={`/caderno/escrever?prato=${receita.id}`}>Conte no Caderno da cozinha</a>.
            </p>
            <p class="pronto-botoes">
              <button type="button" class="botao-texto" data-rever>← Rever os passos</button>
              <button type="button" class="botao-texto" data-recomecar>Desmarcar tudo e recomeçar</button>
            </p>
          </div>

          {
            temVariacoes && (
              <section class="variacoes" aria-labelledby="titulo-variacoes">
                <h2 id="titulo-variacoes" class="versalete rotulo">
                  {variacoes.length > 1 ? 'Variações' : 'Variação'}
                </h2>
                <ul>
                  {variacoes.map((variacao) => (
                    <li>
                      {variacao.texto}
                      {variacao.emTeste && <span class="em-teste versalete">em teste</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </section>
      </div>

      <p class="desmarcar" data-desmarcar hidden>
        <button type="button" class="botao-texto" data-recomecar>Desmarcar tudo</button>
      </p>

      <!-- No fim do cartão, para não empurrar a receita para baixo no celular.
           Precisam de JavaScript: aparecem só quando o script da página roda -->
      <div class="acoes" data-acoes hidden>
        <div class="botoes">
          <button type="button" class="botao cheio entrar" data-entrar aria-describedby="dica-cozinha">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M4 11h16v2.5a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6V11ZM2 11h2M20 11h2M9 7.5c0-1 1-1.5 1-2.5M13 7.5c0-1 1-1.5 1-2.5" />
            </svg>
            Modo cozinha
          </button>
          <button type="button" class="botao guardar" data-guardar aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M6.5 3.5h11v17L12 16.25 6.5 20.5v-17Z" />
            </svg>
            <span data-guardar-rotulo>Guardar receita</span>
          </button>
        </div>
        <p class="dica-acoes" id="dica-cozinha">
          Para riscar ingredientes e passos com um toque, com a tela sempre acesa e letra grande.
        </p>
        <p class="aviso-guardar" data-aviso-guardar role="status"></p>
      </div>

      <!-- Barra do modo cozinha: fica presa embaixo da tela, ao alcance do polegar -->
      <div class="barra-cozinha" data-barra role="region" aria-label="Controles do modo cozinha" hidden>
        <div class="barra-progresso" aria-hidden="true"><span data-barra-progresso></span></div>
        <div class="barra-dentro">
          <button type="button" class="tela" data-tela>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="3.5" />
              <path d="M12 3v1.5M12 19.5V21M3 12h1.5M19.5 12H21M5.6 5.6l1 1M17.4 17.4l1 1M5.6 18.4l1-1M17.4 6.6l1-1" />
            </svg>
            <span data-tela-texto>Ligando…</span>
          </button>
          <div class="barra-botoes">
            <button type="button" class="botao-barra" data-passo-a-passo aria-pressed="false">Um passo por vez</button>
            <button type="button" class="botao-barra letra" data-letra aria-pressed="false">
              <span aria-hidden="true">A<span class="maior">A</span></span>
              <span class="apenas-leitor">Letra ainda maior</span>
            </button>
            <button type="button" class="botao-barra sair" data-sair>Sair</button>
          </div>
        </div>
      </div>
      <p class="apenas-leitor" data-anuncio aria-live="polite"></p>

      <nav class="vizinhas" aria-label="Outras receitas">
        {
          anterior ? (
            <a class="vizinha anterior" href={urlDaReceita(anterior)} rel="prev">
              <span class="versalete">← Anterior</span>
              <span class="nome">{anterior.data.titulo}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          proxima ? (
            <a class="vizinha proxima" href={urlDaReceita(proxima)} rel="next">
              <span class="versalete">Próxima →</span>
              <span class="nome">{proxima.data.titulo}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </Moldura>
    </div>

    <p class="voltar"><a class="versalete" href="/cardapio">Voltar ao cardápio</a></p>
  </div>
</Base>

<style>
  .pagina {
    max-width: 60rem;
  }

  .topo {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .categoria {
    color: var(--cor-destaque);
  }

  h1 {
    font-size: clamp(2.125rem, 1.4rem + 3.4vw, 3.75rem);
    max-width: 18ch;
  }

  h1:focus {
    outline: none;
  }

  .descricao {
    max-width: 34rem;
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.375rem);
    font-style: italic;
    color: var(--cor-texto-2);
  }

  /* ---------- Ações: modo cozinha e guardar ---------- */

  .acoes {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: clamp(1.75rem, 5vw, 2.5rem);
    border-top: 1px solid var(--cor-borda);
    text-align: center;
  }

  .acoes[hidden] {
    display: none;
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .botoes .botao {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
  }

  .botoes svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .guardar[aria-pressed='true'] svg {
    fill: currentColor;
  }

  .dica-acoes {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--cor-texto-3);
  }

  .aviso-guardar {
    min-height: 1.5em;
    font-size: 0.95rem;
    color: var(--cor-rotulo);
  }

  .aviso-guardar:empty {
    min-height: 0;
  }

  /* ---------- Foto ---------- */

  .foto {
    margin-block: clamp(2rem, 5vw, 3rem);
  }

  .foto img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--cor-borda);
  }

  /* ---------- Corpo ---------- */

  .corpo {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3rem);
  }

  @media (min-width: 52rem) {
    .corpo {
      grid-template-columns: minmax(14rem, 2fr) 3fr;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 1rem;
  }

  h2.versalete {
    font-weight: 500;
  }

  .variacoes h2 {
    margin-bottom: 1rem;
  }

  .contagem {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--cor-texto-3);
  }

  .contagem[hidden],
  .receita:not([data-modo-cozinha]) .contagem {
    display: none;
  }

  /* Fora do modo cozinha a receita é só para ler: sem caixinhas, sem riscado.
     Marcar ingredientes e passos é coisa da bancada (modo cozinha). */
  .marcavel {
    display: grid;
  }

  .receita[data-modo-cozinha] .marcavel {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .marcavel .texto {
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .receita[data-modo-cozinha] .feito .marcavel .texto {
    color: var(--cor-texto-3);
    text-decoration: line-through;
    text-decoration-color: var(--cor-rotulo);
    text-decoration-thickness: 1.5px;
  }

  /* ---------- Ingredientes ---------- */

  /* Leitura: lista com marcadores, como sempre foi */
  .lista-ingredientes {
    margin: 0;
    padding-left: 1.1rem;
  }

  .lista-ingredientes li::marker {
    color: var(--cor-destaque);
  }

  .lista-ingredientes li + li {
    margin-top: 0.4rem;
  }

  .lista-ingredientes .marcavel {
    display: block;
  }

  /* Modo cozinha: cada ingrediente ganha a sua caixinha */
  .receita[data-modo-cozinha] .lista-ingredientes {
    padding-left: 0;
    list-style: none;
  }

  .receita[data-modo-cozinha] .lista-ingredientes li + li {
    margin-top: 0;
  }

  .receita[data-modo-cozinha] .lista-ingredientes .marcavel {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    align-items: baseline;
    column-gap: 0.75rem;
    padding-block: 0.3rem;
  }

  /* Caixinha desenhada no traço da casa (só no modo cozinha) */
  .caixa {
    display: none;
  }

  .receita[data-modo-cozinha] .caixa {
    display: block;
    appearance: none;
    position: relative;
    top: 0.18em;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    border: 1.5px solid var(--cor-destaque);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .caixa:checked {
    background: var(--cor-rotulo);
    border-color: var(--cor-rotulo);
  }

  .caixa:checked::after {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.08rem;
    width: 0.3rem;
    height: 0.6rem;
    border: solid var(--cor-fundo);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .caixa:focus-visible {
    outline: 2px solid var(--cor-destaque);
    outline-offset: 3px;
  }

  .no-olho {
    margin-top: 1.25rem;
    font-size: 1rem;
    font-style: italic;
    color: var(--cor-texto-3);
  }

  /* O botão que abre e fecha os ingredientes só existe no passo a passo, no celular */
  .abrir-ingredientes {
    display: none;
  }

  /* ---------- Preparo ---------- */

  .passo-de {
    display: none;
  }

  .passos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .passos li + li {
    margin-top: 1rem;
  }

  .passos .marcavel {
    grid-template-columns: 2.75rem 1fr;
    align-items: baseline;
    column-gap: 0.75rem;
    padding-block: 0.2rem;
  }

  .numero {
    position: relative;
    display: grid;
    justify-items: end;
    font-family: var(--fonte-titulo);
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--cor-destaque);
  }

  .numero .visto {
    position: absolute;
    right: 0;
    top: 0.1em;
    fill: none;
    stroke: var(--cor-rotulo);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .receita[data-modo-cozinha] .feito .numero .algarismo {
    opacity: 0;
  }

  .receita[data-modo-cozinha] .feito .numero .visto {
    opacity: 1;
    transform: scale(1);
  }

  .passos input:focus-visible ~ .texto {
    outline: 2px solid var(--cor-destaque);
    outline-offset: 4px;
  }

  .navegar {
    display: none;
  }

  /* ---------- Pronto ---------- */

  .pronto {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    padding: 1.75rem 1.25rem;
    border: 1px solid var(--cor-borda);
    background: var(--cor-cartao);
    text-align: center;
  }

  .pronto[hidden] {
    display: none;
  }

  .pronto:focus {
    outline: none;
  }

  .pronto-titulo {
    font-family: var(--fonte-titulo);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    color: var(--cor-destaque);
  }

  .pronto-texto {
    color: var(--cor-texto-2);
  }

  .desmarcar {
    margin-top: 1.5rem;
    text-align: center;
  }

  .desmarcar[hidden] {
    display: none;
  }

  /* ---------- Variações ---------- */

  .variacoes {
    margin-top: clamp(2rem, 5vw, 2.75rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--cor-borda);
  }

  .variacoes ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .variacoes li + li {
    margin-top: 0.4rem;
  }

  .variacoes li::marker {
    color: var(--cor-destaque);
  }

  .variacoes li {
    font-style: italic;
  }

  .em-teste {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.05rem 0.4rem 0 0.55rem;
    border: 1px solid var(--cor-rotulo);
    color: var(--cor-rotulo);
    font-style: normal;
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    vertical-align: 0.15em;
  }

  /* ---------- Navegação entre receitas ---------- */

  .vizinhas {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--cor-destaque);
  }

  @media (min-width: 40rem) {
    .vizinhas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .vizinha {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
  }

  .vizinha .versalete {
    font-size: 0.75rem;
    color: var(--cor-texto-3);
  }

  .vizinha .nome {
    font-family: var(--fonte-titulo);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.25;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.15s ease;
  }

  .vizinha:hover .nome {
    text-decoration-color: currentColor;
  }

  @media (min-width: 40rem) {
    .proxima {
      text-align: right;
    }
  }

  .voltar {
    margin-top: 2rem;
    text-align: center;
  }

  .voltar a {
    text-decoration: none;
  }

  /* ==========================================================
     Modo cozinha
     A página vira uma bancada: só título, ingredientes e preparo,
     letra grande, alvos de toque generosos e a barra embaixo.
     ========================================================== */

  .barra-cozinha {
    position: fixed;
    inset: auto 0 0;
    z-index: 30;
    background: var(--cor-fundo);
    border-top: 1px solid var(--cor-destaque);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .barra-cozinha[hidden] {
    display: none;
  }

  .barra-progresso {
    height: 3px;
    background: var(--cor-borda);
  }

  .barra-progresso span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--cor-rotulo);
    transition: width 0.3s ease;
  }

  .barra-dentro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    max-width: 60rem;
    margin-inline: auto;
    padding: 0.55rem 1rem 0.65rem;
  }

  .tela {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: var(--cor-texto-2);
    font: inherit;
    font-size: 0.95rem;
    font-style: italic;
    text-align: left;
    cursor: pointer;
  }

  .tela svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .tela[data-situacao='acesa'] {
    color: var(--cor-rotulo);
  }

  .tela[data-situacao='acesa'] svg {
    fill: currentColor;
  }

  .barra-botoes {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  .botao-barra {
    min-height: 2.75rem;
    padding: 0.4rem 0.85rem 0.35rem;
    border: 1.5px solid var(--cor-destaque);
    background: none;
    color: var(--cor-destaque);
    font-family: var(--fonte-texto);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .botao-barra[aria-pressed='true'] {
    background: var(--cor-destaque);
    color: var(--cor-fundo);
  }

  .botao-barra.letra {
    min-width: 2.75rem;
    padding-inline: 0.6rem;
    letter-spacing: 0;
    font-size: 0.85rem;
    text-transform: none;
  }

  .letra .maior {
    font-size: 1.3em;
  }

  .botao-barra.sair {
    border-color: transparent;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 24rem) {
    .botao-barra {
      padding-inline: 0.6rem;
      letter-spacing: 0.12em;
    }
  }

  /* Fora o que distrai: cabeçalho do site, rodapé, foto, descrição, vizinhas */
  :global(html[data-cozinha]) :global(.cabecalho),
  :global(html[data-cozinha]) :global(.rodape),
  :global(html[data-cozinha]) .voltar,
  .receita[data-modo-cozinha] :global(.separador),
  .receita[data-modo-cozinha] .descricao,
  .receita[data-modo-cozinha] .acoes,
  .receita[data-modo-cozinha] .foto,
  .receita[data-modo-cozinha] .vizinhas,
  .receita[data-modo-cozinha] .no-olho {
    display: none;
  }

  :global(html[data-cozinha]) body {
    padding-bottom: calc(6.5rem + env(safe-area-inset-bottom));
  }

  :global(html[data-cozinha]) {
    scroll-padding-top: 1rem;
  }

  .receita[data-modo-cozinha] {
    --escala: 1.18;
  }

  .receita[data-modo-cozinha][data-letra='enorme'] {
    --escala: 1.4;
  }

  @media (max-width: 40rem) {
    .pagina:has(.receita[data-modo-cozinha]) {
      padding: 0.75rem 0.5rem;
    }

    .receita[data-modo-cozinha] :global(.moldura-interna) {
      padding: 1.25rem 1rem 1.5rem;
    }
  }

  .receita[data-modo-cozinha] .topo {
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .receita[data-modo-cozinha] h1 {
    max-width: none;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
  }

  .receita[data-modo-cozinha] .corpo {
    font-size: calc(1em * var(--escala));
  }

  .receita[data-modo-cozinha] .lista-ingredientes .marcavel {
    grid-template-columns: 1.35em 1fr;
    padding-block: 0.55rem;
  }

  .receita[data-modo-cozinha] .lista-ingredientes li + li {
    border-top: 1px dashed var(--cor-borda);
  }

  .receita[data-modo-cozinha] .caixa {
    width: 1.3em;
    height: 1.3em;
    top: 0.2em;
  }

  .receita[data-modo-cozinha] .caixa:checked::after {
    left: 0.4em;
    top: 0.12em;
    width: 0.35em;
    height: 0.7em;
  }

  .receita[data-modo-cozinha] .passos li + li {
    margin-top: 0;
    border-top: 1px dashed var(--cor-borda);
  }

  .receita[data-modo-cozinha] .passos .marcavel {
    padding-block: 0.85rem;
  }

  /* ---------- Um passo por vez ---------- */

  .receita[data-passo-a-passo] .passo-de {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--cor-rotulo);
  }

  .receita[data-passo-a-passo] .preparo > .cabeca .contagem,
  .receita[data-passo-a-passo] .variacoes {
    display: none;
  }

  .receita[data-passo-a-passo] .passos li:not(.atual) {
    display: none;
  }

  /* Rolar para cima e para baixo fica com o navegador; deslizar para o lado troca de passo */
  .receita[data-passo-a-passo] .passos {
    touch-action: pan-y;
  }

  .receita[data-passo-a-passo] .passos li.atual {
    border-top: 0;
    animation: chegar 0.28s ease-out;
  }

  .receita[data-passo-a-passo][data-voltando] .passos li.atual {
    animation-name: chegar-de-tras;
  }

  .receita[data-passo-a-passo] .passos .marcavel {
    grid-template-columns: 1fr;
    row-gap: 0.75rem;
    padding: clamp(1.25rem, 4vw, 2rem) clamp(1rem, 4vw, 1.75rem);
    border: 1px solid var(--cor-borda);
    background: var(--cor-cartao);
    min-height: 11rem;
    align-content: center;
  }

  .receita[data-passo-a-passo] .numero {
    justify-items: start;
    font-size: 3rem;
  }

  .receita[data-passo-a-passo] .numero .visto {
    left: 0;
    right: auto;
    width: 2.75rem;
    height: 2.75rem;
  }

  .receita[data-passo-a-passo] .passos .texto {
    font-size: clamp(1.45rem, 1.15rem + 1.6vw, 2.1rem);
    line-height: 1.4;
    color: var(--cor-texto);
  }

  .receita[data-passo-a-passo] .feito .marcavel .texto {
    color: var(--cor-texto-3);
  }

  .receita[data-passo-a-passo] .navegar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .navegar .botao {
    min-height: 3.5rem;
    padding-inline: 1rem;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
  }

  @media (max-width: 30rem) {
    .rotulo-anterior {
      display: none;
    }

    .navegar .anterior {
      min-width: 3.5rem;
      font-size: 1.1rem;
      letter-spacing: 0;
    }
  }

  .pronto-botoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
  }

  /* "Rever os passos" só faz sentido no passo a passo */
  .receita:not([data-passo-a-passo]) [data-rever] {
    display: none;
  }

  /* No passo a passo, "Passo 2 de 5" já diz que é o preparo */
  @media (max-width: 51.99rem) {
    .receita[data-passo-a-passo] .preparo > .cabeca {
      display: none;
    }
  }

  .navegar .botao:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .navegar .botao:disabled:hover {
    background: none;
    color: var(--cor-destaque);
  }

  /* Terminou: no passo a passo, a tela de pronto toma o lugar do passo */
  .receita[data-passo-a-passo][data-terminou] .passos,
  .receita[data-passo-a-passo][data-terminou] .navegar,
  .receita[data-passo-a-passo][data-terminou] .passo-de {
    display: none;
  }

  .receita[data-passo-a-passo][data-terminou] .pronto {
    margin-top: 0;
  }

  /* Ingredientes recolhíveis no celular, para o passo ficar à vista */
  @media (max-width: 51.99rem) {
    .receita[data-passo-a-passo] .ingredientes > .cabeca {
      display: none;
    }

    .receita[data-passo-a-passo] .abrir-ingredientes {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      width: 100%;
      margin-bottom: 0.5rem;
      padding: 0.75rem 0;
      border: 0;
      border-bottom: 1px solid var(--cor-borda);
      background: none;
      color: var(--cor-rotulo);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .abrir-ingredientes .versalete {
      font-size: 0.8125rem;
    }

    .abrir-ingredientes svg {
      align-self: center;
      margin-left: auto;
      fill: none;
      stroke: var(--cor-destaque);
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 0.2s ease;
    }

    .abrir-ingredientes[aria-expanded='true'] svg {
      transform: rotate(180deg);
    }

    .receita[data-passo-a-passo] .ingredientes[data-fechado] .lista-ingredientes {
      display: none;
    }

    .receita[data-passo-a-passo] .corpo {
      gap: 1.25rem;
    }
  }

  @keyframes chegar {
    from {
      opacity: 0;
      transform: translateX(1.25rem);
    }
  }

  @keyframes chegar-de-tras {
    from {
      opacity: 0;
      transform: translateX(-1.25rem);
    }
  }

  /* ---------- Impressão: só a receita ---------- */
  @media print {
    .acoes,
    .barra-cozinha,
    .vizinhas,
    .voltar,
    .desmarcar,
    .navegar,
    .pronto {
      display: none !important;
    }
  }
</style>

<script>
  import { estadoVazio, lerEstado, primeiroPendente, type EstadoCozinha } from '../../lib/cozinha';
  import { alternarGuardada, listarGuardadas } from '../../lib/navegador/guardadas';
  import { gravarLocal, lerLocal } from '../../lib/navegador/sessao';

  const receita = document.querySelector<HTMLElement>('[data-receita]')!;
  const slug = receita.dataset.receita!;
  const assinatura = receita.dataset.assinatura!;
  const raiz = document.documentElement;

  const $ = <T extends Element = HTMLElement>(seletor: string) => receita.querySelector<T>(seletor)!;
  const $$ = <T extends Element = HTMLElement>(seletor: string) => [...receita.querySelectorAll<T>(seletor)];

  const caixasIngrediente = $$<HTMLInputElement>('[data-ingrediente]');
  const caixasPasso = $$<HTMLInputElement>('[data-marca-passo]');
  const itensIngrediente = $$('[data-item-ingrediente]');
  const itensPasso = $$('[data-passo]');
  const totais = { ingredientes: caixasIngrediente.length, passos: caixasPasso.length };

  const secaoIngredientes = $('[data-ingredientes]');
  const abrirIngredientes = $<HTMLButtonElement>('[data-abrir-ingredientes]');
  const contagensIngredientes = $$('[data-contagem-ingredientes]');
  const contagemPassos = $('[data-contagem-passos]');
  const passoDe = $('[data-passo-de]');
  const botaoAnterior = $<HTMLButtonElement>('[data-anterior]');
  const botaoFeito = $<HTMLButtonElement>('[data-feito]');
  const pronto = $('[data-pronto]');
  const desmarcar = $('[data-desmarcar]');
  const barra = $('[data-barra]');
  const barraProgresso = $('[data-barra-progresso]');
  const botaoTela = $<HTMLButtonElement>('[data-tela]');
  const textoTela = $('[data-tela-texto]');
  const botaoPassoAPasso = $<HTMLButtonElement>('[data-passo-a-passo]');
  const botaoLetra = $<HTMLButtonElement>('[data-letra]');
  const anuncio = $('[data-anuncio]');
  const botaoEntrar = $<HTMLButtonElement>('[data-entrar]');

  /* ---------- Estado ---------- */

  const CHAVE = `cozinha:${slug}`;
  const CHAVE_PREFERENCIAS = 'cozinha:preferencias';

  interface Preferencias {
    passoAPasso: boolean;
    letra: 'grande' | 'enorme';
  }

  let estado: EstadoCozinha = lerEstado(lerTexto(CHAVE), assinatura, Date.now(), totais);
  const preferencias: Preferencias = { passoAPasso: false, letra: 'grande', ...lerLocal<Preferencias>(CHAVE_PREFERENCIAS) };
  let terminou = false;
  let ingredientesAbertos = estado.passos.length === 0;

  function lerTexto(chave: string): string | null {
    try {
      return localStorage.getItem(chave);
    } catch {
      return null;
    }
  }

  function salvar() {
    estado.atualizadoEm = Date.now();
    const vazio = !estado.modo && estado.ingredientes.length === 0 && estado.passos.length === 0;
    gravarLocal(CHAVE, vazio ? null : estado);
  }

  const anunciar = (texto: string) => {
    anuncio.textContent = '';
    requestAnimationFrame(() => (anuncio.textContent = texto));
  };

  const todosFeitos = () => totais.passos > 0 && estado.passos.length === totais.passos;
  const noModo = () => receita.hasAttribute('data-modo-cozinha');
  const noPassoAPasso = () => receita.hasAttribute('data-passo-a-passo');

  /* ---------- Desenho ---------- */

  function renderizar() {
    const ingredientesFeitos = new Set(estado.ingredientes);
    const passosFeitos = new Set(estado.passos);

    // Só dá para marcar no modo cozinha; fora dele as marcações ficam guardadas, mas não aparecem.
    const marcavel = noModo();
    caixasIngrediente.forEach((caixa, i) => {
      caixa.disabled = !marcavel;
      caixa.checked = ingredientesFeitos.has(i);
      itensIngrediente[i].classList.toggle('feito', caixa.checked);
    });
    caixasPasso.forEach((caixa, i) => {
      caixa.disabled = !marcavel;
      caixa.checked = passosFeitos.has(i);
      itensPasso[i].classList.toggle('feito', caixa.checked);
      itensPasso[i].classList.toggle('atual', i === estado.atual);
    });

    const nIngredientes = `${estado.ingredientes.length} de ${totais.ingredientes} separados`;
    contagensIngredientes.forEach((el) => {
      el.textContent = nIngredientes;
      el.hidden = !marcavel;
    });
    contagemPassos.textContent = `${estado.passos.length} de ${totais.passos} feitos`;
    contagemPassos.hidden = !marcavel;
    barraProgresso.style.width = `${(estado.passos.length / Math.max(totais.passos, 1)) * 100}%`;

    const algoMarcado = estado.ingredientes.length + estado.passos.length > 0;
    desmarcar.hidden = !marcavel || !algoMarcado;

    // Passo a passo
    const atualFeito = passosFeitos.has(estado.atual);
    passoDe.textContent = `Passo ${estado.atual + 1} de ${totais.passos}`;
    botaoAnterior.disabled = estado.atual === 0;
    // Falta algum passo além do que está na tela?
    const faltamOutros = estado.passos.length < totais.passos - (atualFeito ? 0 : 1);
    botaoFeito.textContent = atualFeito
      ? todosFeitos()
        ? 'Ver o final'
        : 'Próximo passo →'
      : faltamOutros
        ? 'Feito · próximo →'
        : 'Feito, terminei!';

    receita.toggleAttribute('data-terminou', terminou && todosFeitos());
    pronto.hidden = !marcavel || !todosFeitos() || (noPassoAPasso() && !terminou);

    secaoIngredientes.toggleAttribute('data-fechado', !ingredientesAbertos);
    abrirIngredientes.setAttribute('aria-expanded', String(ingredientesAbertos));

    botaoPassoAPasso.setAttribute('aria-pressed', String(preferencias.passoAPasso));
    botaoLetra.setAttribute('aria-pressed', String(preferencias.letra === 'enorme'));
    receita.dataset.letra = preferencias.letra;
  }

  function alternarItem(lista: number[], indice: number, marcado: boolean): number[] {
    const conjunto = new Set(lista);
    if (marcado) conjunto.add(indice);
    else conjunto.delete(indice);
    return [...conjunto].sort((a, b) => a - b);
  }

  /* ---------- Marcar ingredientes e passos ---------- */

  caixasIngrediente.forEach((caixa, i) =>
    caixa.addEventListener('change', () => {
      estado.ingredientes = alternarItem(estado.ingredientes, i, caixa.checked);
      salvar();
      renderizar();
    }),
  );

  caixasPasso.forEach((caixa, i) =>
    caixa.addEventListener('change', () => {
      estado.passos = alternarItem(estado.passos, i, caixa.checked);
      if (!caixa.checked) terminou = false;
      // Fora do passo a passo, o "atual" acompanha o primeiro que falta.
      if (!noPassoAPasso()) estado.atual = primeiroPendente(estado.passos, totais.passos);
      salvar();
      renderizar();
      if (todosFeitos() && !noPassoAPasso()) anunciar('Todos os passos feitos. Buon appetito!');
    }),
  );

  function recomecar() {
    estado = { ...estadoVazio(assinatura, Date.now()), modo: estado.modo };
    terminou = false;
    ingredientesAbertos = true;
    salvar();
    renderizar();
    anunciar('Tudo desmarcado.');
    if (noModo()) $('#titulo-receita').focus();
  }
  $$('[data-recomecar]').forEach((botao) => botao.addEventListener('click', recomecar));

  abrirIngredientes.addEventListener('click', () => {
    ingredientesAbertos = !ingredientesAbertos;
    renderizar();
  });

  /* ---------- Um passo por vez ---------- */

  function irPara(indice: number) {
    const destino = Math.min(Math.max(indice, 0), totais.passos - 1);
    receita.toggleAttribute('data-voltando', destino < estado.atual);
    estado.atual = destino;
    terminou = false;
    salvar();
    renderizar();
    const texto = itensPasso[destino].querySelector('.texto')?.textContent ?? '';
    anunciar(`Passo ${destino + 1} de ${totais.passos}. ${texto.replace(/^\s*Passo \d+:\s*/, '').trim()}`);
  }

  botaoAnterior.addEventListener('click', () => irPara(estado.atual - 1));
  $('[data-rever]').addEventListener('click', () => {
    irPara(totais.passos - 1);
    botaoFeito.focus();
  });

  botaoFeito.addEventListener('click', () => {
    estado.passos = alternarItem(estado.passos, estado.atual, true);
    if (todosFeitos()) {
      terminou = true;
      salvar();
      renderizar();
      pronto.focus();
      anunciar('Pronto. Buon appetito!');
      return;
    }
    // Já começou a cozinhar: os ingredientes recolhem para o passo ficar à vista no celular.
    ingredientesAbertos = false;
    // Segue para o próximo que falta (e volta a um que ficou para trás, se for o caso).
    irPara(primeiroPendente(estado.passos, totais.passos, estado.atual + 1));
  });

  function aplicarPassoAPasso() {
    const ligado = noModo() && preferencias.passoAPasso;
    receita.toggleAttribute('data-passo-a-passo', ligado);
    if (ligado) {
      estado.atual = primeiroPendente(estado.passos, totais.passos, estado.atual);
      terminou = todosFeitos();
    }
    renderizar();
  }

  botaoPassoAPasso.addEventListener('click', () => {
    preferencias.passoAPasso = !preferencias.passoAPasso;
    gravarLocal(CHAVE_PREFERENCIAS, preferencias);
    aplicarPassoAPasso();
    anunciar(preferencias.passoAPasso ? 'Um passo por vez.' : 'Todos os passos na tela.');
  });

  botaoLetra.addEventListener('click', () => {
    preferencias.letra = preferencias.letra === 'enorme' ? 'grande' : 'enorme';
    gravarLocal(CHAVE_PREFERENCIAS, preferencias);
    renderizar();
  });

  // Deslizar o dedo para o lado troca de passo. O toque que termina um deslize
  // não pode marcar o passo sem querer.
  const listaPassos = $('[data-passos]');
  let inicioToque: { x: number; y: number } | null = null;
  let engolirClique = false;

  listaPassos.addEventListener('pointerdown', (evento) => {
    inicioToque = evento.pointerType === 'touch' && noPassoAPasso() ? { x: evento.clientX, y: evento.clientY } : null;
  });
  listaPassos.addEventListener('pointerup', (evento) => {
    if (!inicioToque) return;
    const dx = evento.clientX - inicioToque.x;
    const dy = evento.clientY - inicioToque.y;
    inicioToque = null;
    if (Math.abs(dx) > 60 && Math.abs(dy) < 50) {
      engolirClique = true;
      setTimeout(() => (engolirClique = false), 400);
      irPara(estado.atual + (dx < 0 ? 1 : -1));
    }
  });
  listaPassos.addEventListener('pointercancel', () => (inicioToque = null));
  listaPassos.addEventListener(
    'click',
    (evento) => {
      if (engolirClique) {
        evento.preventDefault();
        evento.stopPropagation();
        engolirClique = false;
      }
    },
    true,
  );

  /* ---------- Tela acesa (Wake Lock) ---------- */

  type Situacao = 'ligando' | 'acesa' | 'sem-suporte' | 'falhou';
  const TEXTOS: Record<Situacao, string> = {
    ligando: 'Ligando…',
    acesa: 'Tela acesa enquanto você cozinha',
    'sem-suporte': 'Este navegador não mantém a tela acesa',
    falhou: 'A tela pode apagar. Toque para manter acesa',
  };

  let trava: WakeLockSentinel | null = null;

  function mostrarTela(situacao: Situacao) {
    botaoTela.dataset.situacao = situacao;
    textoTela.textContent = TEXTOS[situacao];
    botaoTela.disabled = situacao === 'acesa' || situacao === 'sem-suporte';
  }

  async function manterTelaAcesa() {
    if (!noModo()) return;
    if (!('wakeLock' in navigator)) return mostrarTela('sem-suporte');
    if (trava && !trava.released) return mostrarTela('acesa');
    try {
      trava = await navigator.wakeLock.request('screen');
      mostrarTela('acesa');
      trava.addEventListener('release', () => {
        trava = null;
        // Saiu da aba: o navegador solta a tela sozinho; ao voltar, pegamos de novo.
        if (noModo() && document.visibilityState === 'visible') mostrarTela('falhou');
      });
    } catch {
      // Alguns navegadores só deixam depois de um toque, ou recusam com bateria fraca.
      mostrarTela('falhou');
      document.addEventListener('pointerdown', () => manterTelaAcesa(), { once: true });
    }
  }

  function soltarTela() {
    trava?.release().catch(() => {});
    trava = null;
  }

  botaoTela.addEventListener('click', () => manterTelaAcesa());
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') manterTelaAcesa();
  });

  /* ---------- Entrar e sair do modo cozinha ---------- */

  function entrar({ restaurando = false } = {}) {
    receita.setAttribute('data-modo-cozinha', '');
    raiz.setAttribute('data-cozinha', '');
    barra.hidden = false;
    estado.modo = true;
    ingredientesAbertos = estado.passos.length === 0;
    salvar();
    mostrarTela('ligando');
    manterTelaAcesa();
    aplicarPassoAPasso();
    window.scrollTo({ top: 0, behavior: restaurando ? 'auto' : 'smooth' });
    if (!restaurando) {
      $('#titulo-receita').focus({ preventScroll: true });
      anunciar('Modo cozinha ligado. Marque os ingredientes e os passos com um toque.');
    }
  }

  function sair() {
    receita.removeAttribute('data-modo-cozinha');
    receita.removeAttribute('data-passo-a-passo');
    receita.removeAttribute('data-terminou');
    raiz.removeAttribute('data-cozinha');
    barra.hidden = true;
    estado.modo = false;
    terminou = false;
    soltarTela();
    salvar();
    renderizar();
    botaoEntrar.focus({ preventScroll: true });
    botaoEntrar.scrollIntoView({ block: 'center', behavior: 'smooth' });
    anunciar('Modo cozinha desligado.');
  }

  botaoEntrar.addEventListener('click', () => entrar());
  $('[data-sair]').addEventListener('click', sair);

  document.addEventListener('keydown', (evento) => {
    if (!noModo() || evento.altKey || evento.ctrlKey || evento.metaKey) return;
    if (evento.key === 'Escape') sair();
    if (!noPassoAPasso()) return;
    if (evento.key === 'ArrowRight') irPara(estado.atual + 1);
    if (evento.key === 'ArrowLeft') irPara(estado.atual - 1);
  });

  /* ---------- Guardar receita ---------- */

  const botaoGuardar = $<HTMLButtonElement>('[data-guardar]');
  const rotuloGuardar = $('[data-guardar-rotulo]');
  const avisoGuardar = $('[data-aviso-guardar]');

  function mostrarGuardada(guardada: boolean) {
    botaoGuardar.setAttribute('aria-pressed', String(guardada));
    rotuloGuardar.textContent = guardada ? 'Guardada' : 'Guardar receita';
  }

  function avisar(texto: string, entrar = false) {
    avisoGuardar.replaceChildren(texto);
    if (entrar) {
      const link = document.createElement('a');
      link.href = `/entrar?proximo=${encodeURIComponent(location.pathname)}`;
      link.textContent = 'Entre com Google';
      avisoGuardar.append(' ', link, ' para ver em qualquer aparelho.');
    }
  }

  listarGuardadas().then(({ slugs }) => mostrarGuardada(slugs.includes(slug)));

  botaoGuardar.addEventListener('click', async () => {
    const guardar = botaoGuardar.getAttribute('aria-pressed') !== 'true';
    mostrarGuardada(guardar);
    botaoGuardar.disabled = true;
    try {
      const { naConta } = await alternarGuardada(slug, guardar);
      if (!guardar) avisar('Tirada das suas receitas guardadas.');
      else if (naConta) avisar('Guardada na sua conta. Ela aparece em Minha conta e no cardápio.');
      else avisar('Guardada neste navegador.', true);
    } catch {
      mostrarGuardada(!guardar);
      avisar('Não deu para guardar agora. Confira a internet e tente de novo.');
    } finally {
      botaoGuardar.disabled = false;
    }
  });

  /* ---------- Começo ---------- */

  $('[data-acoes]').hidden = false;
  renderizar();
  if (estado.modo) entrar({ restaurando: true });
</script>
