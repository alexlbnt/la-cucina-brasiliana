---
import Base from '../layouts/Base.astro';
import Moldura from '../components/Moldura.astro';
import Ratinho from '../components/Ratinho.astro';
import CadernoIndisponivel from '../components/caderno/CadernoIndisponivel.astro';
import { destinoSeguro } from '../lib/caderno';

export const prerender = false;

const { supabase, perfil } = Astro.locals;
const proximo = destinoSeguro(Astro.url.searchParams.get('proximo'));
if (perfil) return Astro.redirect(proximo, 303);

const erro = Astro.url.searchParams.get('erro');
---

<Base titulo="Entrar" descricao="Entre com sua conta Google para escrever no Caderno da cozinha.">
  <div class="pagina">
    <Moldura>
      <div class="entrar">
        <Ratinho tamanho={120} />
        <p class="versalete rotulo">Caderno da cozinha</p>
        <h1>Entrar</h1>
        {
          !supabase ? (
            <CadernoIndisponivel />
          ) : (
            <>
              <p class="texto">
                Para escrever e opinar no caderno, entre com sua conta Google. Seu nome aparece junto do que você
                escrever; seu e-mail nunca é mostrado.
              </p>
              {erro && (
                <p class="aviso erro" role="alert">
                  Não foi possível entrar agora. Tente de novo em instantes.
                </p>
              )}
              <form method="post" action="/api/auth/entrar">
                <input type="hidden" name="proximo" value={proximo} />
                <button class="botao cheio google" type="submit">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3ZM12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Zm-5.6-8c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14Zm5.6-8c1.5 0 2.8.5 3.8 1.5l2.9-2.9A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.9 5.4L6.4 10C7.2 7.7 9.4 6 12 6Z"
                    />
                  </svg>
                  Entrar com Google
                </button>
              </form>
              <p class="letras-miudas">
                Ao entrar, você concorda com os <a href="/termos">termos de uso</a> e a
                <a href="/privacidade">política de privacidade</a>.
              </p>
            </>
          )
        }
      </div>
    </Moldura>
  </div>
</Base>

<style>
  .pagina {
    max-width: 38rem;
  }

  .entrar {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.25rem);
  }

  .texto {
    color: var(--cor-texto-2);
  }

  form {
    margin-top: 0.5rem;
  }

  .google {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .letras-miudas {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--cor-texto-3);
  }
</style>
