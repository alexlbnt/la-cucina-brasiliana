---
import Base from '../layouts/Base.astro';
import Separador from '../components/Separador.astro';
import Assinatura from '../components/caderno/Assinatura.astro';
import BarraDoCaderno from '../components/caderno/BarraDoCaderno.astro';
import { colunasPublicacao, type Autor, type Publicacao } from '../lib/caderno';
import { mapaDePratos } from '../lib/receitas';
import { formatarTexto } from '../lib/texto';

export const prerender = false;

const { supabase, perfil } = Astro.locals;
if (!supabase) return Astro.redirect('/', 303);
if (!perfil) return Astro.redirect(`/entrar?proximo=${encodeURIComponent(Astro.url.pathname)}`, 303);
// Para quem não é admin, a página simplesmente não existe.
if (perfil.papel !== 'admin') return new Response(null, { status: 404, statusText: 'Not Found' });

const MENSAGENS: Record<string, string> = {
  aprovar: 'Publicação aprovada.',
  recusar: 'Publicação recusada.',
  ocultar: 'Opinião ocultada.',
  manter: 'Opinião mantida; denúncias arquivadas.',
};

let deuErro = false;

if (Astro.request.method === 'POST') {
  const formulario = await Astro.request.formData();
  const acao = String(formulario.get('acao') ?? '');
  const alvo = String(formulario.get('alvo') ?? '');
  let erro: unknown = null;

  if (acao === 'aprovar' || acao === 'recusar') {
    ({ error: erro } = await supabase
      .from('publicacoes')
      .update({ status: acao === 'aprovar' ? 'aprovada' : 'recusada' })
      .eq('id', alvo));
  } else if (acao === 'ocultar' || acao === 'manter') {
    if (acao === 'ocultar') {
      ({ error: erro } = await supabase.from('opinioes').update({ oculta: true }).eq('id', alvo));
    }
    if (!erro) {
      ({ error: erro } = await supabase.from('denuncias').update({ resolvida: true }).eq('opiniao_id', alvo));
    }
  }

  if (!erro && MENSAGENS[acao]) return Astro.redirect(`/moderar?ok=${acao}`, 303);
  deuErro = true;
}

const { data: dadosPendentes } = await supabase
  .from('publicacoes')
  .select(colunasPublicacao())
  .eq('status', 'pendente')
  .order('criada_em', { ascending: true });
const pendentes = (dadosPendentes as Publicacao[] | null) ?? [];

interface DenunciaComOpiniao {
  opiniao_id: string;
  opiniao: {
    id: string;
    texto: string;
    criada_em: string;
    publicacao_id: string;
    autor: Autor | null;
  } | null;
}

const { data: dadosDenuncias } = await supabase
  .from('denuncias')
  .select('opiniao_id, opiniao:opinioes(id, texto, criada_em, publicacao_id, autor:perfis(nome, papel))')
  .eq('resolvida', false);

// Agrupa as denúncias por opinião, com a contagem.
const porOpiniao = new Map<string, { total: number; opiniao: NonNullable<DenunciaComOpiniao['opiniao']> }>();
for (const denuncia of (dadosDenuncias as DenunciaComOpiniao[] | null) ?? []) {
  if (!denuncia.opiniao) continue;
  const atual = porOpiniao.get(denuncia.opiniao_id);
  if (atual) atual.total += 1;
  else porOpiniao.set(denuncia.opiniao_id, { total: 1, opiniao: denuncia.opiniao });
}
const denunciadas = [...porOpiniao.values()].sort((a, b) => b.total - a.total);

const pratos = await mapaDePratos();
const ok = MENSAGENS[Astro.url.searchParams.get('ok') ?? ''];
---

<Base titulo="Moderar" descricao="Moderação do Caderno da cozinha.">
  <div class="pagina">
    <BarraDoCaderno />

    <header class="topo">
      <p class="versalete rotulo">Caderno da cozinha</p>
      <h1>Moderar</h1>
      <Separador />
    </header>

    {ok && <p class="aviso" role="status">{ok}</p>}
    {deuErro && <p class="aviso erro" role="alert">Não deu certo desta vez. Tente de novo.</p>}

    <section aria-labelledby="titulo-pendentes">
      <h2 id="titulo-pendentes">
        Publicações esperando leitura <span class="contagem">({pendentes.length})</span>
      </h2>
      {
        pendentes.length === 0 ? (
          <p class="vazio">Nada na fila. Tudo em dia!</p>
        ) : (
          <ol class="fila">
            {pendentes.map((p) => {
              const prato = p.prato_slug ? pratos.get(p.prato_slug) : undefined;
              return (
                <li class="item">
                  {prato && <p class="versalete rotulo prato">{prato}</p>}
                  <h3>
                    <a href={`/caderno/${p.id}`}>{p.titulo}</a>
                  </h3>
                  <Assinatura autor={p.autor} data={p.criada_em} />
                  <div class="texto-livre" set:html={formatarTexto(p.texto)} />
                  <form method="post" class="acoes">
                    <input type="hidden" name="alvo" value={p.id} />
                    <button class="botao cheio" type="submit" name="acao" value="aprovar">
                      Aprovar
                    </button>
                    <button class="botao" type="submit" name="acao" value="recusar">
                      Recusar
                    </button>
                  </form>
                </li>
              );
            })}
          </ol>
        )
      }
    </section>

    <section aria-labelledby="titulo-denuncias">
      <h2 id="titulo-denuncias">
        Opiniões denunciadas <span class="contagem">({denunciadas.length})</span>
      </h2>
      {
        denunciadas.length === 0 ? (
          <p class="vazio">Nenhuma denúncia em aberto.</p>
        ) : (
          <ol class="fila">
            {denunciadas.map(({ total, opiniao }) => (
              <li class="item">
                <p class="versalete rotulo">
                  {total === 1 ? '1 denúncia' : `${total} denúncias`}
                </p>
                <Assinatura autor={opiniao.autor} data={opiniao.criada_em} />
                <div class="texto-livre" set:html={formatarTexto(opiniao.texto)} />
                <p>
                  <a href={`/caderno/${opiniao.publicacao_id}#opiniao-${opiniao.id}`}>Ver no contexto</a>
                </p>
                <form method="post" class="acoes">
                  <input type="hidden" name="alvo" value={opiniao.id} />
                  <button class="botao cheio" type="submit" name="acao" value="ocultar">
                    Ocultar
                  </button>
                  <button class="botao" type="submit" name="acao" value="manter">
                    Manter
                  </button>
                </form>
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </div>
</Base>

<style>
  .pagina {
    display: grid;
    gap: 2rem;
    max-width: 48rem;
  }

  .topo {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.25rem);
  }

  section {
    display: grid;
    gap: 1rem;
  }

  h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .contagem {
    font-family: var(--fonte-texto);
    font-weight: 400;
    color: var(--cor-texto-3);
  }

  .vazio {
    font-style: italic;
    color: var(--cor-texto-2);
  }

  .fila {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    gap: 0.85rem;
    padding: clamp(1.25rem, 4vw, 1.75rem);
    background: var(--cor-cartao);
    border: 1px solid var(--cor-borda);
  }

  .prato {
    font-size: 0.75rem;
  }

  h3 {
    font-size: 1.35rem;
    color: var(--cor-texto);
  }

  h3 a {
    color: inherit;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
</style>
