---
import Base from '../layouts/Base.astro';
import Moldura from '../components/Moldura.astro';
import Esgabilado from '../components/Esgabilado.astro';

// Renderizada na hora: assim as páginas do Caderno conseguem responder com
// esta 404 (na Vercel, uma 404 estática não fica disponível para elas).
export const prerender = false;
---

<Base titulo="Página não encontrada" descricao="Esta página não está no cardápio.">
  <div class="pagina">
    <Moldura>
      <div class="nao-encontrada">
        <Esgabilado
          cena="colher"
          tamanho="min(60vw, 240px)"
          titulo="O Esgabilado, o ratinho cozinheiro, provando o molho numa colher de pau"
        />
        <p class="versalete rotulo">Erro 404</p>
        <h1>Esse prato não está no cardápio</h1>
        <p class="texto">A página que você procurou não existe, ou o Esgabilado ainda está provando.</p>
        <div class="acoes">
          <a class="botao" href="/cardapio">Ver o cardápio</a>
          <a class="versalete inicio" href="/">Voltar ao início</a>
        </div>
      </div>
    </Moldura>
  </div>
</Base>

<style>
  .pagina {
    max-width: 44rem;
  }

  .nao-encontrada {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    max-width: 16ch;
  }

  .texto {
    font-style: italic;
    color: var(--cor-texto-2);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: 1rem;
  }

  .inicio {
    text-decoration: none;
  }
</style>
