---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Separador from '../components/Separador.astro';
import ilustracaoMesa from '../assets/ilustracao-mesa.png';

// O desenho é só tinta sobre fundo transparente: vira máscara e é pintado com a
// cor de destaque, então acompanha o modo escuro sem uma segunda versão.
const mascara = await getImage({ src: ilustracaoMesa, format: 'webp', width: 736 });
const proporcao = `${ilustracaoMesa.width} / ${ilustracaoMesa.height}`;
---

<Base titulo="Sobre" descricao="Sobre La cucina brasiliana, uma cozinha de hobby com base italiana.">
  <article class="sobre pagina">
    <header class="topo">
      <p class="versalete rotulo">La cucina brasiliana</p>
      <h1>Sobre</h1>
      <Separador />
    </header>

    <figure class="ilustracao">
      <div
        class="desenho"
        role="img"
        aria-label="Desenho a pincel de duas pessoas sentadas à mesa de um café, com copos sobre a mesa e cadeiras de ferro."
        style={`--mascara: url('${mascara.src}'); aspect-ratio: ${proporcao}`}
      >
      </div>
    </figure>

    <div class="texto">
      <p>[TEXTO SOBRE MIM — vou escrever depois]</p>
    </div>
  </article>
</Base>

<style>
  .sobre {
    max-width: 44rem;
  }

  .topo {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.75rem, 2rem + 4vw, 4.5rem);
    line-height: 1;
  }

  .ilustracao {
    margin: clamp(2rem, 5vw, 3rem) auto;
    max-width: 35rem;
  }

  .desenho {
    width: 100%;
    background-color: var(--cor-destaque);
    -webkit-mask: var(--mascara) center / contain no-repeat;
    mask: var(--mascara) center / contain no-repeat;
    forced-color-adjust: none;
  }

  .texto {
    max-width: var(--largura-texto);
    margin-inline: auto;
  }

  .texto p + p {
    margin-top: 1rem;
  }
</style>
